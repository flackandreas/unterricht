# Datenbank-Konfiguration
DB_HOST=db
DB_USER=root
DB_PASS=db_user
DB_NAME=db_unterricht

# Kanonische Basis-URL der Anwendung, z.B. https://schule.example
# Wird fuer Links, QR-Codes und die OIDC-Redirect-URI verwendet. Ohne diesen
# Wert wird der Host-Header ausgewertet, der vom Client manipulierbar ist.
APP_URL=

# Vermittler, deren X-Forwarded-For geglaubt wird - kommagetrennt, einzelne
# Adressen oder Netze in CIDR-Schreibweise. Das Wort "private" steht als
# Abkuerzung fuer alle privaten Netze und die Rueckschleife.
#
# Bleibt der Wert leer, zaehlt allein die Adresse der Verbindung. Hinter einem
# Proxy heisst das: alle Zugriffe kommen scheinbar von derselben Adresse, und
# die Mengenbegrenzungen (Anmeldeversuche, Abgaben, Feedback) greifen fuer die
# ganze Schule gemeinsam. Wer hinter einem Proxy betreibt, sollte das hier
# setzen - ungeprueft uebernehmen darf man den Header aber nicht: sonst
# bestimmt jeder Aufrufer seinen eigenen Zaehler.
#
# Vorgabe: die Docker-Bridge-Netze. Das trifft den Aufbau dieser Installation,
# in der der Reverse Proxy als Container neben dem Modul haengt. Bewusst nicht
# "private": 10.x und 192.168.x sind die Schulnetze, und wer dort Port 8889
# direkt erreicht, koennte den Header sonst wieder faelschen.
TRUSTED_PROXIES=172.16.0.0/12

# Eigene, kurze Adresse fuer alles, was Schuelerinnen und Schueler zu sehen
# bekommen: Hausaufgaben, Feedback, Vertretungsmappe. Die Links und QR-Codes
# dafuer entstehen in der Lehreransicht und trugen sonst deren Adresse.
# Leer lassen: dann gilt APP_URL, und es aendert sich nichts.
SCHUELER_URL=

# Gemini API-Schlüssel für die Hausaufgaben-Korrektur (AIService)
GEMINI_API_KEY=
# Optional: abweichendes Modell
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# SchulOS-Portal
#
# Sind diese vier Werte gesetzt, laeuft die Anmeldung ueber das Portal: eine
# Anmeldung fuer alle Module der Schule. Bleiben sie leer, verhaelt sich das
# Modul wie bisher mit eigener Anmeldemaske und eigenen Konten.
#
# Client-Kennung und Geheimnis muessen zu dem passen, was im Portal hinterlegt
# ist. Im Server-Verbund setzt beides die compose.yml des Portals.
# ---------------------------------------------------------------------------
PORTAL_ISSUER=
PORTAL_CLIENT_ID=modul-unterricht
PORTAL_CLIENT_SECRET=
PORTAL_REDIRECT_URI=

# Adresse des Portals fuer Abrufe von Server zu Server (Entdeckung, Token,
# UserInfo, JWKS). Nur noetig, wenn die oeffentliche Adresse vom Server aus
# nicht erreichbar ist - im Containerverbund ist das der Regelfall, dort steht
# hier etwa "http://portal". Leer lassen, wenn beide Wege gleich sind.
PORTAL_INTERN=

# Wer im Portal in einer dieser Gruppen steht, ist hier Verwaltung.
PORTAL_ADMIN_GRUPPEN=Schulleitung

# Kommagetrennte Portal-Gruppen, deren Mitglieder dieses Modul betreten und
# beim ersten Mal automatisch als Lehrkraft angelegt werden, z.B.
# "Lehrer,Kollegium".
#
# Bleibt der Wert leer, wird NIEMAND automatisch angelegt - dann koennen sich
# nur bereits eingetragene Lehrkraefte anmelden. Das ist die sichere Vorgabe
# und dieselbe wie bei ISERV_TEACHER_GROUPS. (Vorher hiess leer: jede im
# Portal angemeldete Person bekommt hier ein Lehrkraftkonto.)
#
# Die Schulleitung steht mit in der Liste: wer im Portal nur dort und nicht
# zusaetzlich unter "Lehrer" gefuehrt wird, kaeme sonst nicht herein.
# PORTAL_ADMIN_GRUPPEN entscheidet danach ueber die Verwaltungsrechte, nicht
# ueber den Zugang.
PORTAL_ZUGANG_GRUPPEN=Lehrer,Schulleitung

# Ausschliesslich ueber das Portal anmelden. 1 schliesst die oertliche
# Anmeldemaske ganz - auch ?lokal=1 fuehrt dann zum Portal.
#
# Fuer oeffentlich erreichbare Instanzen gedacht: dort ist ein mitgeliefertes
# Konto eine offene Tuer, und wer es uebernimmt, behaelt es. Vorgabe ist aus,
# damit eine Schule im Zweifel noch hereinkommt, wenn das Portal steht.
PORTAL_NUR_SSO=0

# IServ OIDC-Konfiguration
#
# Nur fuer den Betrieb ohne Portal. Mit Portal wird IServ dort eingerichtet,
# nicht hier - dann gibt es an der Schule genau eine IServ-Registrierung
# statt einer je Modul.
ISERV_HOST=
ISERV_CLIENT_ID=
ISERV_CLIENT_SECRET=

# Optional: zusaetzliche Scopes, falls Gruppeninformationen benoetigt werden,
# z.B. "openid profile email groups"
ISERV_SCOPES="openid profile email"

# Kommaseparierte IServ-Gruppen, deren Mitglieder beim ersten SSO-Login
# automatisch als Lehrkraft angelegt werden, z.B. "Lehrer,Kollegium".
# Bleibt der Wert leer, wird NIEMAND automatisch angelegt - dann koennen sich
# nur bereits eingetragene Lehrkraefte anmelden. Das ist die sichere Vorgabe.
ISERV_TEACHER_GROUPS=

# SSO-Autologin Secret - muss ein zufälliger Schlüssel mit mindestens
# 32 Zeichen sein. Erzeugen mit: openssl rand -hex 32
SSO_SECRET=

# Aufbewahrungsfrist der Beteiligungserfassung in Tagen.
#
# Der Zweck der Strichliste ist die mündliche Note des laufenden Schuljahres
# und die Fähigkeit, sie während der Widerspruchsfrist zu begründen. Danach
# ist sie gegenstandslos - eine Aufzeichnung darüber, wer wann etwas gesagt
# hat, gehört dann nicht mehr aufbewahrt. 400 Tage decken Schuljahr plus
# Widerspruchszeitraum ab; die Frist sollte die Schule bewusst setzen.
# Gelöscht wird durch "php bin/retention.php --apply".
PARTICIPATION_RETENTION_DAYS=400

# Migrationen beim ersten Request automatisch einspielen (Netz für Deployments,
# bei denen "php bin/migrate.php" vergessen wurde). 0 schaltet das ab.
AUTO_MIGRATE=1

# "production" oder "development".
#
# production (Vorgabe): Fehler werden protokolliert, aber nicht ausgegeben.
# development: Fehler erscheinen zusaetzlich im Browser - nur fuer die
# Entwicklung, niemals an einer Instanz, die Schuelerinnen und Schueler
# erreichen.
APP_ENV=production
