{% extends "base.twig" %}
{% import "_symbole.twig" as symbol %}

{% block title %}Unterricht live{% endblock %}

{% block extra_head %}
<style>
    .live-kopf {
        display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);
        margin-bottom: var(--space-4);
    }
    .live-kopf select, .live-kopf input {
        padding: 8px 10px; border: 1px solid var(--border-color);
        border-radius: var(--radius-sm); background: var(--bg-content);
        color: var(--text-dark); font-size: var(--text-sm); font-family: var(--font-sans);
    }
    .live-status {
        margin-left: auto; font-size: var(--text-xs); font-weight: 600;
        padding: 4px 10px; border-radius: var(--radius-full);
        background: var(--bg-table-header); color: var(--text-muted);
    }
    .live-status--offen { background: var(--warning-color); color: #fff; }
    .live-status--offline { background: var(--danger-bg); color: var(--danger-color-dark); }

    .live-raster {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: var(--space-3);
        margin: var(--space-4) 0;
    }
    .live-kachel {
        position: relative;
        display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
        min-height: 60px; padding: var(--space-3);
        border: 1px solid var(--border-color); border-radius: var(--radius-md);
        background: var(--bg-content); color: var(--text-dark);
        font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 600;
        text-align: left; cursor: pointer; user-select: none;
        -webkit-tap-highlight-color: transparent;
        transition: transform 0.08s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .live-kachel:active { transform: scale(0.97); }
    .live-kachel:focus-visible { outline: 3px solid var(--primary-color); outline-offset: 2px; }
    .live-kachel--still { background: var(--bg-main); color: var(--text-muted); border-style: dashed; }
    .live-zaehler {
        flex-shrink: 0; min-width: 28px; height: 28px; padding: 0 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: var(--radius-full); background: var(--primary-color);
        color: #fff; font-size: var(--text-sm); font-variant-numeric: tabular-nums;
    }
    .live-kachel--still .live-zaehler { background: transparent; }

    .live-blende {
        display: none; position: fixed; inset: 0; z-index: 1000;
        background: rgba(0,0,0,0.5); align-items: flex-end; justify-content: center;
    }
    .live-blatt {
        background: var(--bg-content); border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: var(--space-6); width: 100%; max-width: 520px;
        box-shadow: var(--shadow-medium);
    }
    .live-gewichte { display: flex; gap: var(--space-2); margin: var(--space-4) 0; }
    .live-gewichte button {
        flex: 1; padding: var(--space-4) var(--space-2); border-radius: var(--radius-md);
        border: 1px solid var(--border-color); background: var(--bg-main);
        color: var(--text-dark); cursor: pointer; font-family: var(--font-sans);
        font-size: var(--text-sm); font-weight: 600; line-height: 1.3;
    }
    .live-gewichte button:hover { border-color: var(--primary-color); }
    .live-gewichte small { display: block; font-weight: 400; color: var(--text-muted); font-size: var(--text-xs); }

    @media (min-width: 900px) {
        .live-blende { align-items: center; }
        .live-blatt { border-radius: var(--radius-lg); }
    }
</style>
{% endblock %}

{% block content %}

{% if meine_klassen|length == 0 %}
    <div class="content-box">
        <h2 style="margin-top: 0;">Unterricht live</h2>
        <p style="color: var(--text-muted);">
            Für dich ist noch keine Klasse hinterlegt. Die Zuordnung passiert im
            <a href="/dashboard">Dashboard</a>.
        </p>
    </div>

{% elseif klasse is null %}
    <div class="content-box">
        <h2 style="margin-top: 0;">Welche Klasse?</h2>
        <p style="color: var(--text-muted); font-size: var(--text-sm);">
            Ab der zweiten Woche schlägt der Erfassungsschirm die Stunde von selbst vor.
        </p>
        <div class="live-raster">
            {% for k in meine_klassen %}
                <a href="/live.php?class_id={{ k.id }}&period={{ period }}" class="live-kachel" style="text-decoration: none; justify-content: center;">
                    {{ k.name }}
                </a>
            {% endfor %}
        </div>
    </div>

{% elseif fach is empty %}
    <div class="content-box">
        <h2 style="margin-top: 0;">{{ klasse.name }} &ndash; welches Fach?</h2>
        {% if faecher|length > 0 %}
            <div class="live-raster">
                {% for f in faecher %}
                    <a href="/live.php?class_id={{ class_id }}&period={{ period }}&fach={{ f|url_encode }}" class="live-kachel" style="text-decoration: none; justify-content: center;">
                        {{ f }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
        <form method="GET" action="/live.php" style="margin-top: var(--space-4); display: flex; gap: var(--space-2); flex-wrap: wrap;">
            <input type="hidden" name="class_id" value="{{ class_id }}">
            <input type="hidden" name="period" value="{{ period }}">
            <input type="text" name="fach" required placeholder="Neues Fach"
                   style="flex: 1; min-width: 180px; padding: 10px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-content); color: var(--text-dark);">
            <button type="submit" style="background-color: var(--primary-color); color: #fff; border: none; padding: 10px 18px; border-radius: var(--radius-sm); cursor: pointer; font-weight: 600;">
                Weiter
            </button>
        </form>
        <p style="color: var(--text-muted); font-size: var(--text-xs); margin-top: var(--space-3);">
            Schreibweise beibehalten: &bdquo;Mathe&ldquo; und &bdquo;Mathematik&ldquo; nebeneinander lassen den Themenverlauf zerfallen.
        </p>
    </div>

{% elseif liste|length == 0 %}
    <div class="content-box">
        <h2 style="margin-top: 0;">{{ klasse.name }}: keine Klassenliste</h2>
        <p style="color: var(--text-muted);">
            Für {{ klasse.name }} ist noch keine Liste hinterlegt. Sie wird in der Verwaltung
            eingefügt &ndash; danach lässt sich hier erfassen.
        </p>
    </div>

{% else %}
    <div class="content-box">
        <div class="live-kopf">
            <strong style="font-size: var(--text-lg);">{{ klasse.name }} &middot; {{ fach }}</strong>

            <form method="GET" action="/live.php" style="display: contents;">
                <input type="hidden" name="class_id" value="{{ class_id }}">
                <input type="hidden" name="fach" value="{{ fach }}">
                <label for="period" style="font-size: var(--text-sm); color: var(--text-muted);">Stunde</label>
                <select name="period" id="period" onchange="this.form.submit()">
                    {% for p in 1..10 %}
                        <option value="{{ p }}" {{ p == period ? 'selected' : '' }}>{{ p }}.</option>
                    {% endfor %}
                </select>
            </form>

            <span id="live-ausstehend" class="live-status">Gespeichert</span>
        </div>

        {% if vermutung and vermutung.class_id == class_id and not vermutung.sicher %}
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0 0 var(--space-3) 0;">
                {{ symbol.zeichne('hinweis', 14) }} Vorschlag aus deiner bisherigen Erfassung &ndash; oben korrigierbar.
            </p>
        {% endif %}

        <label for="live-thema" style="display: block; font-weight: 600; font-size: var(--text-sm); margin-bottom: var(--space-2);">
            Thema der Stunde
        </label>
        <input type="text" id="live-thema" maxlength="255"
               value="{{ session.topic ?? '' }}"
               placeholder="{{ letztes_thema ? 'zuletzt: ' ~ letztes_thema : 'z. B. Bruchrechnen – Addition' }}"
               style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box; background: var(--bg-content); color: var(--text-dark);">
        <p style="font-size: var(--text-xs); color: var(--text-muted); margin: var(--space-2) 0 0 0;">
            Trägt später die Vertretungsstunde. Bleibt das Feld leer, entsteht dort ein Lückenfüller.
        </p>

        <div class="live-raster">
            {% for s in liste %}
                <button type="button" class="live-kachel live-kachel--still"
                        data-student-id="{{ s.id }}" data-name="{{ s.display_name }}">
                    <span>{{ s.display_name }}</span>
                    <span class="live-zaehler"></span>
                </button>
            {% endfor %}
        </div>

        <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; border-top: 1px solid var(--border-color); padding-top: var(--space-4);">
            <span id="live-still" style="color: var(--text-muted); font-size: var(--text-sm);"></span>

            <button type="button" id="live-undo" disabled
                    style="margin-left: auto; background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 14px; border-radius: var(--radius-sm); cursor: pointer; font-size: var(--text-sm);">
                Zurücknehmen
            </button>
            <a href="#" id="live-abschluss"
               style="background-color: var(--primary-color); color: #fff; text-decoration: none; padding: 9px 18px; border-radius: var(--radius-sm); font-weight: 600; font-size: var(--text-sm);">
                Stunde abschließen
            </a>
        </div>

        <p style="font-size: var(--text-xs); color: var(--text-muted); margin: var(--space-3) 0 0 0;">
            Tippen zählt einen Beitrag. Lange drücken öffnet Gewichtung und Notiz, Wischen nach links nimmt zurück.
        </p>
    </div>

    <div class="live-blende" id="live-auswahl">
        <div class="live-blatt">
            <strong class="live-auswahl-name" style="font-size: var(--text-lg);"></strong>

            <div class="live-gewichte">
                <button type="button" data-gewicht="1">Kurz<small>Wort, Nennung</small></button>
                <button type="button" data-gewicht="2">Solide<small>trägt bei</small></button>
                <button type="button" data-gewicht="3">Weiterführend<small>bringt voran</small></button>
            </div>

            <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); margin-bottom: var(--space-3);">
                <input type="checkbox" id="live-aufgerufen">
                aufgerufen, nicht gemeldet
            </label>

            <input type="text" id="live-notiz" maxlength="200" placeholder="Notiz (optional)"
                   style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); box-sizing: border-box; background: var(--bg-content); color: var(--text-dark);">

            <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4);">
                <button type="button" id="live-auswahl-undo"
                        style="background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); padding: 10px 14px; border-radius: var(--radius-sm); cursor: pointer;">
                    Letzten zurücknehmen
                </button>
                <button type="button" id="live-auswahl-abbrechen"
                        style="margin-left: auto; background: transparent; border: 1px solid var(--border-color); color: var(--text-dark); padding: 10px 18px; border-radius: var(--radius-sm); cursor: pointer;">
                    Abbrechen
                </button>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block extra_scripts %}
{% if klasse and fach is not empty and liste|length > 0 %}
<script>
    window.LIVE_CONFIG = {
        csrfToken: {{ csrf_token|json_encode|raw }},
        classId: {{ class_id }},
        fach: {{ fach|json_encode|raw }},
        period: {{ period }},
        date: {{ datum|json_encode|raw }},
        topic: {{ (session.topic ?? '')|json_encode|raw }},
        stand: {{ stand|json_encode|raw }}
    };
</script>
<script src="{{ asset('/js/live.js') }}" defer></script>
{% endif %}
{% endblock %}
