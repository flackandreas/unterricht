{% extends "base.twig" %}

{% block content %}

{% include 'partials/_neue_zugaenge.twig' %}

<div class="content-box" style="margin-bottom: 25px;">
    <h2 style="margin-top: 0;">KI-Nutzung &amp; Warteschlange</h2>
    <p style="color: var(--text-muted); font-size: 0.9em; margin-top: 0;">
        Ohne diese Zahlen gibt es keine Kostentransparenz – der Verbrauch wurde vorher nirgends erfasst.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 20px;">
        <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Aufrufe ({{ ai_usage.days }} Tage)</div>
            <div style="font-size: 1.6em; font-weight: 700;">{{ ai_usage.calls }}</div>
        </div>
        <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Tokens gesamt</div>
            <div style="font-size: 1.6em; font-weight: 700;">{{ ai_usage.tokens|number_format(0, ',', '.') }}</div>
        </div>
        <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Warteschlange</div>
            <div style="font-size: 1.6em; font-weight: 700;">{{ queue_counts.queued + queue_counts.running }}</div>
        </div>
        <div style="background: {{ queue_counts.failed > 0 ? '#fef2f2' : '#f8fafc' }}; border: 1px solid {{ queue_counts.failed > 0 ? '#fca5a5' : 'var(--border-color)' }}; border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.8em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fehlgeschlagen</div>
            <div style="font-size: 1.6em; font-weight: 700; color: {{ queue_counts.failed > 0 ? 'var(--danger-color)' : 'inherit' }};">{{ queue_counts.failed }}</div>
        </div>
    </div>

    {% if ai_usage.features is not empty %}
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
            <thead>
                <tr style="background: #f8fafc; text-align: left; border-bottom: 2px solid var(--border-color);">
                    <th style="padding: 8px 12px;">Funktion</th>
                    <th style="padding: 8px 12px; text-align: right;">Aufrufe</th>
                    <th style="padding: 8px 12px; text-align: right;">Tokens</th>
                </tr>
            </thead>
            <tbody>
                {% for f in ai_usage.features %}
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <td style="padding: 8px 12px;">
                            {% if f.feature == 'evaluation' %}Hausaufgaben-Auswertung
                            {% elseif f.feature == 'summary' %}Klassen-Zusammenfassung
                            {% elseif f.feature == 'rephrase' %}Feedback umformulieren
                            {% else %}{{ f.feature }}{% endif %}
                        </td>
                        <td style="padding: 8px 12px; text-align: right;">{{ f.calls }}</td>
                        <td style="padding: 8px 12px; text-align: right;">{{ f.tokens|number_format(0, ',', '.') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p style="color: var(--text-muted); margin: 0;">In den letzten {{ ai_usage.days }} Tagen wurden keine KI-Aufrufe erfasst.</p>
    {% endif %}
</div>
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Systemverwaltung & Datenpflege</h2>
    <a href="/admin/klassen" class="btn" style="border: 1px solid var(--border-color); color: var(--text-dark); padding: 8px 16px; border-radius: 6px; text-decoration: none;">&larr; Zurück</a>
</div>

{# =====================================================================
   SECTION: Lehrerverwaltung (CSV Import)
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid #8e44ad; padding-left: 10px;">Lehrkräfte CSV-Import</h3>
{% if portal_aktiv %}
    <p style="color: var(--text-muted); margin-bottom: 0;">
        Konten werden am <a href="{{ portal_adresse }}/verwaltung/benutzer">SchulOS-Portal</a> verwaltet – dort
        gilt eine Liste für alle Module. Hier ist nichts einzulesen: der Eintrag entsteht, sobald sich die
        Person zum ersten Mal in diesem Modul anmeldet.
    </p>
{% else %}
    <p style="color: var(--text-muted); margin-bottom: 15px;">
        Importiere Lehrkräfte aus einer CSV-Datei. Erwartetes Format: <strong>Kürzel;Name;Email</strong> (erste Zeile wird als Überschrift ignoriert). 
        Existierende Kürzel werden übersprungen. Jedes neue Konto bekommt ein eigenes Zufallspasswort,
        das nach dem Import einmalig angezeigt wird und beim ersten Anmelden gewechselt werden muss.
    </p>
    <form method="POST" action="/admin_system.php" enctype="multipart/form-data" class="modern-form" style="max-width: 500px;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="form-group">
            <label for="teacher_csv" class="form-label">CSV-Datei auswählen:</label>
            <input type="file" name="teacher_csv" id="teacher_csv" accept=".csv" required class="form-control" style="padding: 10px; border: 1px dashed var(--border-color); width: 100%;">
        </div>
        <div style="margin-top: 15px;">
            <button type="submit" class="button-primary" style="background-color: #8e44ad; width: auto;">Import starten</button>
        </div>
    </form>
{% endif %}
</div>

{# =====================================================================
   SECTION: Jahresabschluss & Archivierung
   ===================================================================== #}
<div class="content-box">
    <h3 style="border-left: 4px solid #e67e22; padding-left: 10px;">Jahresabschluss</h3>
    <p style="color: var(--text-muted); font-size: 0.9em;">
        Zwei getrennte Schritte. Das Archiv nimmt ein Schuljahr vollständig mit – der Löschlauf hält sich an
        die Fristen, die in den Hausaufgaben und in <code>PARTICIPATION_RETENTION_DAYS</code> stehen. Er löscht
        <strong>nicht</strong> das Schuljahr, das Sie oben auswählen.
    </p>

    <div style="display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; margin-top: 15px;">
        <form method="POST" action="/admin_archive.php" style="display: flex; gap: 12px; align-items: flex-end;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="export">

            <div class="form-group" style="margin-bottom: 0;">
                <label for="schuljahr" class="form-label">Schuljahr</label>
                <select name="schuljahr" id="schuljahr" class="form-control" style="background: white;">
                    {% set beginn = "now"|date("n") >= 8 ? "now"|date("Y") : "now"|date("Y") - 1 %}
                    {% for versatz in 0..3 %}
                        {% set jahr = beginn - versatz %}
                        <option value="{{ jahr }}">{{ jahr }}/{{ (jahr + 1) % 100 }}{{ versatz == 0 ? ' (laufend)' : '' }}</option>
                    {% endfor %}
                </select>
            </div>

            <button type="submit" class="button-primary" style="background-color: #3498db; width: auto;">Archiv herunterladen</button>
        </form>
    </div>

    <p style="color: var(--text-muted); font-size: 0.85em; margin-top: 12px;">
        Das Archiv enthält Klassenlisten, Hausaufgaben samt Korrektur, Beteiligungsbelege und das Protokoll –
        also <strong>Namen von Minderjährigen</strong>. Zugangstoken und Passwörter sind nicht enthalten.
        Wer es herunterlädt, steht im Änderungsprotokoll. Bitte sicher ablegen.
    </p>

    <div style="border-top: 1px solid var(--border-color); margin-top: 20px; padding-top: 20px;">
        <h4 style="margin: 0 0 8px;">Löschlauf</h4>
        <p style="color: var(--text-muted); font-size: 0.9em;">
            Entfernt Hausaufgabenfotos nach der je Aufgabe eingestellten Frist (das Feedback bleibt) und
            Beteiligungsdaten nach <code>PARTICIPATION_RETENTION_DAYS</code>. Dasselbe tut der tägliche
            <code>bin/retention.php</code> – hier von Hand, wenn er nicht eingerichtet ist.
        </p>

        <form method="POST" action="/admin_archive.php" id="loeschform">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="loeschen">
            <button type="button" class="button-danger" id="loeschknopf" style="width: auto;">Löschlauf starten</button>
        </form>
    </div>
</div>

<script nonce="{{ csp_nonce() }}">
document.getElementById('loeschknopf').addEventListener('click', function () {
    Swal.fire({
        title: 'Löschlauf starten?',
        text: 'Abgelaufene Hausaufgabenfotos und Beteiligungsdaten werden endgültig entfernt. Erst das Archiv herunterladen.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: 'var(--danger-color)',
        cancelButtonColor: 'var(--text-muted)',
        confirmButtonText: 'Ja, löschen',
        cancelButtonText: 'Abbrechen'
    }).then(function (ergebnis) {
        if (ergebnis.isConfirmed) {
            document.getElementById('loeschform').submit();
        }
    });
});
</script>
{% endblock %}
