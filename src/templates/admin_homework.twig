{% extends "base.twig" %}

{% block content %}
{% if review_count > 0 %}
    <div class="content-box" style="margin-bottom: 20px; border-left: 4px solid #f59e0b; background: #fffbeb; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
        <span style="font-weight: 600; color: #92400e;">
            ⏳ {{ review_count }} Auswertung{{ review_count == 1 ? '' : 'en' }} warte{{ review_count == 1 ? 't' : 'n' }} auf deine Freigabe.
        </span>
        <a href="/admin_homework.php?action=review" style="text-decoration: none; background: #f59e0b; color: white; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 0.9em;">Jetzt prüfen</a>
    </div>
{% endif %}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h1>Hausaufgaben (KI-Auswertung)</h1>
    <a href="/admin_dashboard.php" class="btn" style="text-decoration: none; border: 1px solid var(--border-color); color: var(--text-dark); padding: 8px 16px; border-radius: 4px;">Zurück zum Dashboard</a>
</div>

<div style="margin-bottom: 25px;">
    <details style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 6px; padding: 15px; cursor: pointer;">
        <summary style="font-weight: 600; color: var(--primary-color); outline: none;">ℹ️ Wie funktioniert die KI-Auswertung? (Hier klicken)</summary>
        <div style="margin-top: 15px; font-size: 0.95em; color: var(--text-dark); line-height: 1.5; cursor: default;">
            <p style="margin-top: 0;"><strong>Vorteile für Lehrkräfte & Schüler:</strong></p>
            <ul style="margin-bottom: 0;">
                <li><strong>Zeitersparnis:</strong> Du musst nicht mehr Dutzende von Hausaufgaben einzeln durchsehen. Die KI analysiert die eingereichten Fotos in Sekundenschnelle.</li>
                <li><strong>Gezielte Förderung:</strong> Du erhältst pro Einreichung sofort eine kurze Zusammenfassung der fachlichen Fehler und Lernschwierigkeiten. So kannst du in der nächsten Stunde direkt auf die Probleme der Klasse eingehen.</li>
                <li><strong>Individuelles Feedback:</strong> Jeder Schüler bekommt ein ermutigendes, konstruktives Feedback zur eigenen Lösung, was die Eigenverantwortung und Motivation deutlich steigert.</li>
                <li><strong>Letztes Wort hat die Lehrkraft:</strong> Im Modus &bdquo;Erst nach Freigabe&ldquo; sieht die Klasse die Auswertung erst, wenn du sie geprüft hast.</li>
                <li><strong>Datenschutz (DSGVO):</strong> Die Klarnamen der Schüler bleiben auf dem Schulserver. Sie werden durch ein Pseudonym ersetzt, bevor das Bild zur Auswertung an die KI (Google Gemini) gesendet wird.</li>
            </ul>
        </div>
    </details>
</div>

<div class="content-box" style="margin-bottom: 30px; border-top: 4px solid #2ecc71;">
    <h2 style="margin-top: 0;">Neue Hausaufgabe erstellen</h2>
    <form action="/admin_homework.php?action=create" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-bottom: 15px;">
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Klasse</label>
                <select name="klasse" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background-color: white;">
                    <option value="">Bitte wählen</option>
                    {% if selected_class_ids|length > 0 %}
                        <optgroup label="Meine Klassen">
                            {% for c in all_classes %}
                                {% if c.id in selected_class_ids %}
                                    <option value="{{ c.name }}">{{ c.name }}</option>
                                {% endif %}
                            {% endfor %}
                        </optgroup>
                        <optgroup label="Alle Klassen">
                            {% for c in all_classes %}
                                <option value="{{ c.name }}">{{ c.name }}</option>
                            {% endfor %}
                        </optgroup>
                    {% else %}
                        {% for c in all_classes %}
                            <option value="{{ c.name }}">{{ c.name }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Fach</label>
                <input type="text" name="fach" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Erwartete Abgaben</label>
                <input type="number" name="expected_submissions" min="0" value="25" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">🎁 Quest-Belohnung (optional)</label>
                <input type="text" name="quest_reward" placeholder="z.B. 5 Min. Musik hören" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">🎯 KI-Feedback-Sprachniveau für Schüler</label>
            <select name="feedback_level" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #fff;">
                <option value="simple">🟢 Sehr einfache Sprache (leicht verständlich, kurze Sätze, anschaulich)</option>
                <option value="appropriate" selected>🔵 Der Klassenstufe angemessen (Standard-Fachsprache)</option>
                <option value="complex">🟣 Komplexe & detaillierte Erläuterungen (hohes sprachliches & fachliches Niveau)</option>
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Titel der Hausaufgabe</label>
            <input type="text" name="title" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;" placeholder="z.B. S. 14 Nr. 3a">
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Aufgabenstellung / Kontext für die KI</label>
            <textarea name="description" required rows="4" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;" placeholder="Beschreibe kurz die Aufgabe, damit die KI weiß, worauf sie bei der Auswertung achten muss..."></textarea>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 15px;">
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">📅 Abgabe bis (optional)</label>
                <input type="datetime-local" name="due_date" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">🔁 Versuche je Schüler/in</label>
                <input type="number" name="max_submissions_per_student" min="1" max="10" value="3" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
            </div>
            <div class="form-group" style="margin: 0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">🗑️ Fotos löschen nach (Tagen)</label>
                <input type="number" name="retention_days" min="0" max="3650" value="90" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
                <p style="color: var(--text-muted); font-size: 0.8em; margin: 5px 0 0 0;">0 = nie automatisch löschen. Das Feedback bleibt in jedem Fall erhalten.</p>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">👀 Wann sieht die Klasse die Auswertung?</label>
            <select name="release_mode" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #fff;">
                <option value="immediate" selected>🟢 Übungsmodus – sofort nach der Auswertung (formativ, ohne Freigabe)</option>
                <option value="review">🟡 Erst nach deiner Freigabe – du prüfst jede Auswertung vorher</option>
            </select>
            <p style="color: var(--text-muted); font-size: 0.85em; margin-top: 5px;">
                Für benotete oder heikle Aufgaben empfiehlt sich die Freigabe: Eine Fehleinschätzung der KI erreicht dann niemanden ungeprüft.
            </p>
        </div>

        <div style="display: flex; gap: 25px; margin-bottom: 20px; flex-wrap: wrap;">
            <label style="display: flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer;">
                <input type="checkbox" name="show_score" value="1" checked style="width: 18px; height: 18px;"> Punktzahl für Schüler/innen anzeigen
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-weight: 500; cursor: pointer;">
                <input type="checkbox" name="allow_resubmission" value="1" checked style="width: 18px; height: 18px;"> Verbesserte Wiedervorlage erlauben
            </label>
        </div>

        {% include 'partials/_criteria_form.twig' with { 'criteria': [] } %}

        <div class="form-group" style="margin-bottom: 25px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Kontext-Bild / PDF-Dokument (Lösung, Muster oder Aufgabenblatt)</label>
            <input type="file" name="context_image" accept="image/*,application/pdf" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #fff;">
            <p style="color: var(--text-muted); font-size: 0.85em; margin-top: 5px;">Optional: Ein Bild oder eine PDF-Datei der Musterlösung/Aufgabe hilft der KI, die Schülerantworten präziser zu bewerten.</p>
        </div>

        <div style="text-align: right;">
            <button type="submit" class="btn btn-primary" style="background-color: #2ecc71; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: 600;">Hausaufgabe erstellen</button>
        </div>
    </form>
</div>

<div class="content-box">
    <h2 style="margin-top: 0;">Aktive &amp; vergangene Hausaufgaben</h2>

    {% if queue_counts.queued > 0 or queue_counts.running > 0 or queue_counts.failed > 0 %}
        <p style="font-size: 0.85em; color: var(--text-muted); margin: 0 0 15px 0;">
            Auswertungs-Warteschlange:
            <strong>{{ queue_counts.queued }}</strong> wartend,
            <strong>{{ queue_counts.running }}</strong> laufend{% if queue_counts.failed > 0 %},
            <strong style="color: var(--danger-color);">{{ queue_counts.failed }}</strong> fehlgeschlagen{% endif %}
        </p>
    {% endif %}

    {% if assignments is empty %}
        <p style="color: var(--text-muted); text-align: center; padding: 30px 20px; margin: 0;">
            Noch keine Hausaufgaben angelegt.
        </p>
    {% else %}
        <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f8fafc; text-align: left; border-bottom: 2px solid var(--border-color);">
                    <th style="padding: 12px;">Erstellt</th>
                    <th style="padding: 12px;">Klasse / Fach</th>
                    <th style="padding: 12px;">Titel</th>
                    <th style="padding: 12px; text-align: center;">Abgaben</th>
                    <th style="padding: 12px; text-align: center;">Ø Punkte</th>
                    <th style="padding: 12px; text-align: center;">Status</th>
                    <th style="padding: 12px; text-align: right;">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for assignment in assignments %}
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <td style="padding: 12px; white-space: nowrap;">{{ assignment.created_at|date('d.m.Y') }}</td>
                        <td style="padding: 12px;"><strong>{{ assignment.klasse }}</strong> &middot; {{ assignment.fach }}</td>
                        <td style="padding: 12px;">
                            {{ assignment.title }}
                            {% if assignment.due_date %}
                                <span style="display: block; font-size: 0.8em; color: {{ assignment.due_date|date('U') < 'now'|date('U') ? 'var(--danger-color)' : 'var(--text-muted)' }};">
                                    fällig {{ assignment.due_date|date('d.m.Y, H:i') }}
                                </span>
                            {% endif %}
                        </td>
                        <td style="padding: 12px; text-align: center;">
                            <span class="badge" style="background-color: var(--primary-color); color: white; padding: 4px 10px; border-radius: 12px; font-weight: 600;">
                                {{ assignment.student_count }}{% if assignment.expected_submissions > 0 %} / {{ assignment.expected_submissions }}{% endif %}
                            </span>
                        </td>
                        <td style="padding: 12px; text-align: center; color: var(--text-muted);">
                            {{ assignment.avg_score is null ? '–' : assignment.avg_score }}
                        </td>
                        <td style="padding: 12px; text-align: center; font-size: 0.85em; white-space: nowrap;">
                            {% if assignment.draft_count > 0 %}
                                <span style="color: #92400e; font-weight: 600;">⏳ {{ assignment.draft_count }} zu prüfen</span>
                            {% elseif assignment.pending_count > 0 %}
                                <span style="color: #075985;">⚙️ {{ assignment.pending_count }} in Arbeit</span>
                            {% elseif assignment.submission_count > 0 %}
                                <span style="color: var(--primary-color);">✓ vollständig</span>
                            {% else %}
                                <span style="color: var(--text-muted);">–</span>
                            {% endif %}
                        </td>
                        <td style="padding: 12px; text-align: right; white-space: nowrap;">
                            <a href="/admin_homework.php?action=view&id={{ assignment.id }}" class="btn" style="background-color: #f1f5f9; color: var(--primary-color); padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 0.9em; display: inline-block;">Ergebnisse &amp; Link</a>
                            <button type="button" class="button-danger btn-delete-assignment" data-id="{{ assignment.id }}" style="padding: 6px 12px; font-size: 0.9em; border-radius: 4px; margin-left: 5px; display: inline-block;">Löschen</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>

        {% if total_pages > 1 %}
            <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 20px; font-size: 0.9em;">
                {% if page > 1 %}
                    <a href="/admin_homework.php?page={{ page - 1 }}" style="padding: 6px 14px; border: 1px solid var(--border-color); border-radius: 4px; text-decoration: none; color: var(--text-dark);">&larr; Zurück</a>
                {% endif %}
                <span style="color: var(--text-muted);">Seite {{ page }} von {{ total_pages }} ({{ total_assignments }} Hausaufgaben)</span>
                {% if page < total_pages %}
                    <a href="/admin_homework.php?page={{ page + 1 }}" style="padding: 6px 14px; border: 1px solid var(--border-color); border-radius: 4px; text-decoration: none; color: var(--text-dark);">Weiter &rarr;</a>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>

<div class="content-box" style="margin-top: 30px;">
    <form id="delete-assignment-form" action="/admin_homework.php?action=delete_assignment" method="POST" style="display: none;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="assignment_id" id="delete-assignment-id" value="">
    </form>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    // Löschen einer Hausaufgabe - mit Rückfrage, da alle Abgaben mitgehen.
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.btn-delete-assignment').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = this.dataset.id;
                Swal.fire({
                    title: 'Hausaufgabe löschen?',
                    text: 'Alle Einreichungen, Bewertungen und hochgeladenen Bilder dieser Hausaufgabe werden endgültig gelöscht.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--danger-color)',
                    cancelButtonColor: 'var(--text-muted)',
                    confirmButtonText: 'Ja, löschen',
                    cancelButtonText: 'Abbrechen'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        document.getElementById('delete-assignment-id').value = id;
                        document.getElementById('delete-assignment-form').submit();
                    }
                });
            });
        });
    });
</script>
{% endblock %}
