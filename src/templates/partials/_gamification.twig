{#
    Lernfortschritt.
    Die Werte kommen jetzt vom Server (Tabelle student_progress) statt aus dem
    localStorage. Sie sind damit geräteunabhängig und nicht mehr über die
    Entwicklerkonsole manipulierbar.
#}
<div class="gamification-header" style="display: flex; gap: 20px; align-items: center; background: linear-gradient(135deg, #1e293b, #0f172a); color: white; padding: 20px; border-radius: 12px; margin-bottom: 25px; box-shadow: 0 10px 25px rgba(15, 23, 42, 0.3); border: 1px solid rgba(255,255,255,0.05); overflow: hidden; position: relative;">
    <div style="position: absolute; top: -50%; left: -20%; width: 60%; height: 200%; background: radial-gradient(circle, rgba(46, 204, 113, 0.15) 0%, transparent 60%); pointer-events: none;"></div>

    <div style="position: relative; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 8px;">
        <div style="position: relative;">
            <img id="gamification-avatar" src="" alt="Avatar" style="width: 75px; height: 75px; border-radius: 50%; background: #f1f5f9; border: 3px solid var(--primary-color); display: block; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
            <div style="position: absolute; bottom: -5px; right: -5px; background: var(--primary-color); color: white; font-weight: bold; font-size: 0.75em; padding: 4px 8px; border-radius: 10px; border: 2px solid #0f172a; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                Lvl {{ progress.level }}
            </div>
        </div>
        <select id="gamification-avatar-style" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 4px; padding: 2px 6px; font-size: 0.7em; cursor: pointer; outline: none; max-width: 90px; text-align-last: center; font-weight: 500;">
            {% for wert, name in {'adventurer': 'Abenteuer', 'bottts': 'Roboter', 'fun-emoji': 'Emoji', 'lorelei': 'Comic', 'pixel-art': 'Pixel-Art'} %}
                <option value="{{ wert }}" style="background: #1e293b; color: white;"{{ progress.avatar_style == wert ? ' selected' : '' }}>{{ name }}</option>
            {% endfor %}
        </select>
    </div>

    <div style="flex-grow: 1; min-width: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span style="font-weight: 700; font-size: 1.1em; letter-spacing: 0.5px;">{{ progress.display_name|default('Schüler/in') }}</span>
            <span style="font-size: 0.85em; color: #94a3b8; font-weight: 600;">{{ progress.xp_in_level }} / {{ progress.xp_for_next_level }} XP</span>
        </div>

        <div style="width: 100%; height: 10px; background: rgba(255,255,255,0.1); border-radius: 5px; overflow: hidden; margin-bottom: 10px;">
            <div style="width: {{ progress.level_percent }}%; height: 100%; background: linear-gradient(90deg, #2ecc71, #58d68d); transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 5px;"></div>
        </div>

        <div style="display: flex; gap: 15px; font-size: 0.85em; color: #cbd5e1; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 4px;">
                <span style="font-size: 1.1em;">🔥</span>
                <strong style="color: #ff7675;">{{ progress.streak }}er-Streak</strong>
            </div>
            <div style="display: flex; align-items: center; gap: 4px;">
                <span>⭐</span>
                <span>{{ progress.xp }} XP gesamt</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Avatar lokal erzeugen - der Seed verlässt das Gerät nicht.
    (function () {
        var seed = {{ (progress.avatar_seed|default('anon'))|json_encode|raw }};
        var img = document.getElementById('gamification-avatar');
        var select = document.getElementById('gamification-avatar-style');
        if (!img || typeof localAvatar !== 'function') return;

        function zeichne() {
            img.src = localAvatar(select ? select.value : 'adventurer', seed);
        }
        zeichne();
        if (select) {
            select.addEventListener('change', function () {
                zeichne();
                // Nur die Darstellung, keine Fortschrittsdaten.
                try { localStorage.setItem('avatar_style', select.value); } catch (e) {}
            });
        }
    })();
</script>
