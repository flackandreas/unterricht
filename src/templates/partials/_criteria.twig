{#
    Bewertungsraster.
    Ersetzt die frei erfundene Gesamtpunktzahl durch nachvollziehbare
    Teilkriterien. Erwartet: criteria
#}
{% if criteria is not empty %}
    <div style="margin-bottom: 25px;">
        <h4 style="margin: 0 0 12px 0; font-size: 1.05em; display: flex; align-items: center; gap: 8px;">
            <span>📋</span> Bewertungsraster
        </h4>

        {% for k in criteria %}
            <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px 16px; margin-bottom: 10px; background: #fff;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap;">
                    <strong style="font-size: 0.95em;">{{ k.label }}</strong>
                    <span style="font-size: 0.9em; font-weight: 700; color: {{ k.percent >= 75 ? '#059669' : (k.percent >= 40 ? '#b45309' : '#b91c1c') }};">
                        {{ k.points is null ? '–' : k.points }} / {{ k.max_points }} Punkte
                    </span>
                </div>

                {% if k.points is not null %}
                    <div style="width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 8px 0;">
                        <div style="width: {{ k.percent }}%; height: 100%; background: {{ k.percent >= 75 ? '#10b981' : (k.percent >= 40 ? '#f59e0b' : '#ef4444') }}; border-radius: 4px;"></div>
                    </div>
                {% endif %}

                {% if k.comment %}
                    <p class="math-format" style="margin: 6px 0 0 0; font-size: 0.88em; color: #475569; line-height: 1.45;">{{ k.comment }}</p>
                {% elseif k.description %}
                    <p style="margin: 6px 0 0 0; font-size: 0.85em; color: #94a3b8;">{{ k.description }}</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
