{% extends "base.twig" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <div>
        <h1 style="margin: 0;">Auswertungen prüfen</h1>
        <p style="margin: 6px 0 0 0; color: var(--text-muted); font-size: 0.92em;">
            Diese Auswertungen sind fertig, aber noch nicht bei den Schülerinnen und Schülern.
            Erst deine Freigabe macht sie sichtbar.
        </p>
    </div>
    <a href="/admin_homework.php" class="btn" style="text-decoration: none; border: 1px solid var(--border-color); color: var(--text-dark); padding: 8px 16px; border-radius: 4px;">Zur Übersicht</a>
</div>

{% if flash_success %}<div class="status success" style="margin-bottom: 20px;">{{ flash_success }}</div>{% endif %}
{% if flash_error %}<div class="status error" style="margin-bottom: 20px;">{{ flash_error }}</div>{% endif %}

{% if queue is empty %}
    <div class="content-box" style="text-align: center; padding: 50px 20px;">
        <div style="font-size: 2.5em; margin-bottom: 10px;">✅</div>
        <p style="color: var(--text-muted); font-size: 1.05em; margin: 0;">Nichts zu prüfen – alle Auswertungen sind freigegeben.</p>
    </div>
{% else %}
    {% for eintrag in queue %}
        <div class="content-box" style="margin-bottom: 20px; border-left: 4px solid #f59e0b; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; flex-wrap: wrap; margin-bottom: 12px;">
                <div>
                    <h3 style="margin: 0 0 4px 0; font-size: 1.1em;">{{ eintrag.student_name }}</h3>
                    <span style="font-size: 0.85em; color: var(--text-muted);">
                        {{ eintrag.klasse }} &middot; {{ eintrag.fach }} &middot; {{ eintrag.title }}
                        &middot; {{ eintrag.created_at|date('d.m.Y, H:i') }}
                        {% if eintrag.attempt_no > 1 %} &middot; {{ eintrag.attempt_no }}. Versuch{% endif %}
                    </span>
                </div>
                {% if eintrag.score is not null %}
                    <span style="font-weight: 700; font-size: 1.15em; color: var(--primary-color); white-space: nowrap;">{{ eintrag.score }} / 100</span>
                {% endif %}
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 15px; margin-bottom: 15px;">
                <div>
                    <strong style="font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Feedback an Schüler/in</strong>
                    <div class="math-format" style="margin-top: 6px; background: #f0fdf4; padding: 12px; border-radius: 6px; font-size: 0.9em; line-height: 1.5; white-space: pre-wrap; max-height: 220px; overflow-y: auto;">{{ eintrag.student_feedback }}</div>
                </div>
                <div>
                    <strong style="font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Notizen für dich</strong>
                    <div class="math-format" style="margin-top: 6px; background: #f8fafc; padding: 12px; border-radius: 6px; font-size: 0.9em; line-height: 1.5; white-space: pre-wrap; max-height: 220px; overflow-y: auto;">{{ eintrag.teacher_notes }}</div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
                <a href="/media.php?sub={{ eintrag.submission_id }}" target="_blank" class="btn" style="padding: 8px 16px; background: #f1f5f9; color: var(--text-dark); border: 1px solid var(--border-color); border-radius: 4px; text-decoration: none; font-size: 0.9em;">📄 Abgabe ansehen</a>
                <a href="/admin_homework.php?action=view&id={{ eintrag.assignment_id }}" class="btn" style="padding: 8px 16px; background: #f1f5f9; color: var(--text-dark); border: 1px solid var(--border-color); border-radius: 4px; text-decoration: none; font-size: 0.9em;">✏️ Bearbeiten</a>
                <form action="/admin_homework.php?action=release" method="POST" style="margin: 0;">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="submission_id" value="{{ eintrag.submission_id }}">
                    <button type="submit" class="btn btn-primary" style="padding: 8px 20px; background: var(--primary-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.9em;">✓ Freigeben</button>
                </form>
            </div>
        </div>
    {% endfor %}
{% endif %}
{% endblock %}

{% block extra_scripts %}
{% include 'partials/_math_format.twig' %}
{% endblock %}
