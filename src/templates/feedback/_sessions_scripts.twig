{#
    Skripte des Sitzungen-Tabs.
    Die Handler hängen an Klassen statt an onclick-/onchange-Attributen im
    Markup – damit kommt die Seite ohne inline-Eventhandler aus.
#}
<script>
(function () {
    'use strict';

    var container = document.getElementById('questions-container');
    var zaehler = container ? container.querySelectorAll('.question-row').length : 0;

    function escapeHtml(str) {
        if (typeof str !== 'string') return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    /** Blendet das Optionsfeld ein, sobald „Multiple Choice" gewählt ist. */
    function optionsfeldUmschalten(select) {
        var zeile = select.closest('.question-row');
        if (!zeile) return;

        var box = zeile.querySelector('.options-container');
        if (!box) return;

        box.style.display = select.value === 'mc' ? 'block' : 'none';

        var eingabe = box.querySelector('input');
        if (eingabe && select.value !== 'mc') {
            eingabe.value = '';
        }
    }

    function frageAnlegen(text, typ, optionen) {
        if (!container) return;

        text = typeof text === 'string' ? text : '';
        typ = typeof typ === 'string' ? typ : 'emoji';
        optionen = typeof optionen === 'string' ? optionen : '';

        var idx = zaehler++;
        var div = document.createElement('div');
        div.className = 'question-row';
        div.style.cssText = 'background:#fff;border:1px solid #e2e8f0;border-left:4px solid var(--primary-color);'
            + 'border-radius:8px;padding:16px;margin-bottom:20px;box-shadow:0 2px 6px rgba(0,0,0,0.04);';

        div.innerHTML =
            '<div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">' +
                '<input type="text" name="questions[' + idx + '][text]" value="' + escapeHtml(text) + '" ' +
                    'placeholder="Eigene Frage eingeben…" aria-label="Fragentext" required ' +
                    'style="flex:1;min-width:200px;padding:10px 14px;border:1px solid #cbd5e1;border-radius:6px;font-size:0.95rem;box-sizing:border-box;">' +
                '<select name="questions[' + idx + '][type]" class="frage-typ" ' +
                    'style="width:210px;min-width:170px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;font-size:0.9rem;color:#334155;cursor:pointer;">' +
                    '<option value="emoji"' + (typ === 'emoji' ? ' selected' : '') + '>Emoji-Bewertung (1–5)</option>' +
                    '<option value="text"' + (typ === 'text' ? ' selected' : '') + '>Freitext-Antwort</option>' +
                    '<option value="mc"' + (typ === 'mc' ? ' selected' : '') + '>Multiple Choice</option>' +
                '</select>' +
                '<button type="button" class="frage-loeschen" aria-label="Frage löschen" ' +
                    'style="background:#ff7675;color:#fff;border:none;padding:10px 14px;border-radius:6px;cursor:pointer;font-size:1rem;font-weight:bold;height:42px;">&times;</button>' +
            '</div>' +
            '<div class="options-container" style="display:' + (typ === 'mc' ? 'block' : 'none') + ';margin-top:12px;padding-top:12px;border-top:1px dashed #e2e8f0;">' +
                '<label style="display:block;font-size:0.85em;color:#475569;margin-bottom:6px;font-weight:600;">Antwortoptionen (kommagetrennt):</label>' +
                '<input type="text" name="questions[' + idx + '][options]" value="' + escapeHtml(optionen) + '" ' +
                    'placeholder="z.B. Ja, Nein, Vielleicht" style="width:100%;padding:8px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:0.9rem;box-sizing:border-box;">' +
            '</div>';

        container.appendChild(div);
    }

    // Eine Delegation für alle Fragezeilen, auch für später erzeugte.
    if (container) {
        container.addEventListener('change', function (e) {
            if (e.target.classList.contains('frage-typ')) {
                optionsfeldUmschalten(e.target);
            }
        });
        container.addEventListener('click', function (e) {
            if (e.target.classList.contains('frage-loeschen')) {
                e.target.closest('.question-row').remove();
            }
        });
    }

    var hinzufuegen = document.getElementById('frage-hinzufuegen');
    if (hinzufuegen) {
        hinzufuegen.addEventListener('click', function () { frageAnlegen('', 'emoji', ''); });
    }

    // Name der Vorlage nur abfragen, wenn gespeichert werden soll.
    var speichern = document.getElementById('save-as-template-checkbox');
    if (speichern) {
        speichern.addEventListener('change', function () {
            var box = document.getElementById('template-title-container');
            var eingabe = document.getElementById('template-title-input');
            if (!box || !eingabe) return;

            box.style.display = this.checked ? 'block' : 'none';
            eingabe.required = this.checked;
            if (!this.checked) eingabe.value = '';
        });
    }

    // Vorlage laden: Klasse, Fach und Fragen übernehmen.
    var vorlagenAuswahl = document.getElementById('template-select');
    if (vorlagenAuswahl) {
        vorlagenAuswahl.addEventListener('change', function () {
            var option = this.options[this.selectedIndex];

            var klasse = option.getAttribute('data-klasse') || '';
            var fach = option.getAttribute('data-fach') || '';
            var klasseFeld = document.querySelector('select[name="klasse"]');
            var fachFeld = document.querySelector('input[name="fach"]');

            if (klasseFeld && klasse !== '') klasseFeld.value = klasse;
            if (fachFeld && fach !== '') fachFeld.value = fach;

            var fragen = [];
            try {
                fragen = JSON.parse(option.getAttribute('data-questions') || '[]');
            } catch (e) {
                fragen = [];
            }

            if (!container) return;
            container.querySelectorAll('.question-row').forEach(function (zeile) { zeile.remove(); });

            if (fragen.length === 0) {
                frageAnlegen('', 'emoji', '');
                return;
            }

            fragen.forEach(function (f) {
                if (f && typeof f === 'object') {
                    frageAnlegen(f.text, f.type, f.options);
                } else {
                    frageAnlegen(f, 'emoji', '');
                }
            });
        });
    }

    // Vorlage löschen: Rückfrage.
    document.querySelectorAll('.vorlage-loeschen').forEach(function (formular) {
        formular.addEventListener('submit', function (e) {
            e.preventDefault();
            Swal.fire({
                title: 'Vorlage löschen?',
                text: 'Die gespeicherten Fragen dieser Vorlage gehen verloren.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--danger-color)',
                cancelButtonColor: 'var(--text-muted)',
                confirmButtonText: 'Ja, löschen',
                cancelButtonText: 'Abbrechen'
            }).then(function (ergebnis) {
                if (ergebnis.isConfirmed) formular.submit();
            });
        });
    });

    // QR-Code in Großansicht.
    var modal = document.getElementById('qrModal');
    var klein = document.getElementById('qr-klein');

    function modalOeffnen() {
        if (!modal) return;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function modalSchliessen() {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    if (klein) {
        klein.addEventListener('click', modalOeffnen);
        klein.addEventListener('mouseover', function () { this.style.transform = 'scale(1.05)'; });
        klein.addEventListener('mouseout', function () { this.style.transform = 'scale(1)'; });
    }
    if (modal) {
        modal.addEventListener('click', modalSchliessen);
        modal.querySelector('.qr-modal-content').addEventListener('click', function (e) { e.stopPropagation(); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') modalSchliessen();
        });
    }
})();
</script>
