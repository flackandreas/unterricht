{#
    Tab „Sitzungen": laufende Sitzung bzw. Startformular, darunter die
    vergangenen Sitzungen. Die Liste stand vorher in der Trend-Analyse –
    wer die Ergebnisse von gestern sehen wollte, musste dorthin wechseln,
    ohne einen Trend zu suchen.
#}
<div class="content-box" style="border-top: 4px solid var(--primary-color);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; flex-wrap: wrap;">
        <div>
            <h2 style="margin-top: 0;">Feedback-Sitzung</h2>
            <p style="color: var(--text-muted); margin-bottom: 20px;">Starten Sie eine Live-Feedback-Runde für Ihre aktuelle Stunde.</p>
        </div>
        {% if active_session %}
            <span class="badge" style="background-color: var(--success-color, #2ecc71); color: white; padding: 5px 10px; border-radius: 4px;">Sitzung aktiv</span>
        {% endif %}
    </div>

    {% if active_session %}
        <div style="display: flex; gap: 30px; align-items: center; background: #f9f9f9; padding: 20px; border-radius: 8px; flex-wrap: wrap;">
            <div style="text-align: center;">
                <img src="{{ qr_data_uri(host_url ~ '/student_feedback.php?t=' ~ active_session.token, 150) }}"
                     alt="QR-Code zur Abstimmung"
                     id="qr-klein"
                     style="border: 10px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.2s;">
                <div style="margin-top: 10px; font-size: 0.8em; color: var(--text-muted);">Großansicht (Klick)</div>
            </div>
            <div style="flex: 1; min-width: 260px;">
                <h3 style="margin: 0 0 10px 0;">{{ active_session.klasse }} &middot; {{ active_session.fach }}</h3>
                <p style="margin: 0 0 20px 0; font-size: 0.9em;">Schülerinnen und Schüler können jetzt unter diesem Link abstimmen:</p>
                <code style="display: block; background: #eee; padding: 10px; border-radius: 4px; margin-bottom: 20px; font-size: 0.8em; word-break: break-all;">{{ host_url }}/student_feedback.php?t={{ active_session.token }}</code>

                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <form action="/feedback_action.php" method="POST" style="margin: 0;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="action" value="stop">
                        <button type="submit" class="btn btn-danger" style="background-color: var(--danger-color); color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer;">Sitzung beenden</button>
                    </form>
                    <a href="/feedback_view.php?id={{ active_session.id }}" class="btn" style="text-decoration: none; color: var(--primary-color); border: 1px solid var(--primary-color); padding: 9px 20px; border-radius: 4px;">Ergebnisse ansehen</a>
                </div>
            </div>
        </div>
    {% else %}
        <form action="/feedback_action.php" method="POST" style="background: #f9f9f9; padding: 25px; border-radius: 8px;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="start">

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 25px;">
                <div class="form-group" style="margin: 0;">
                    <label for="klasse-select" style="display: block; margin-bottom: 8px; font-weight: 600;">Klasse</label>
                    <select id="klasse-select" name="klasse" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px; background-color: white;">
                        <option value="">Bitte wählen</option>
                        {% if selected_class_ids|length > 0 %}
                            <optgroup label="Meine Klassen">
                                {% for c in all_classes %}
                                    {% if c.id in selected_class_ids %}
                                        <option value="{{ c.name }}">{{ c.name }}</option>
                                    {% endif %}
                                {% endfor %}
                            </optgroup>
                            <optgroup label="Alle Klassen">
                                {% for c in all_classes %}
                                    <option value="{{ c.name }}">{{ c.name }}</option>
                                {% endfor %}
                            </optgroup>
                        {% else %}
                            {% for c in all_classes %}
                                <option value="{{ c.name }}">{{ c.name }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>
                <div class="form-group" style="margin: 0;">
                    <label for="fach-input" style="display: block; margin-bottom: 8px; font-weight: 600;">Fach</label>
                    <input type="text" id="fach-input" name="fach" placeholder="z.B. Mathe" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px;">
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 25px;">
                <label for="template-select" style="display: block; margin-bottom: 8px; font-weight: 600;">Vorlage laden</label>
                <select id="template-select" style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px; background-color: white;">
                    <option value="default" data-klasse="" data-fach="" data-questions='["Wie war die heutige Stunde?", "Wie ist aktuell das Klassenklima?"]'>Standard-Fragen (2 Fragen)</option>
                    <option value="empty" data-klasse="" data-fach="" data-questions='[]'>Leere Fragenliste</option>
                    {% for t in templates %}
                        <option value="{{ t.id }}" data-klasse="{{ t.klasse|escape('html_attr') }}" data-fach="{{ t.fach|escape('html_attr') }}" data-questions="{{ t.questions|json_encode|escape('html_attr') }}">{{ t.title }} ({{ t.question_count }} {{ t.question_count == 1 ? 'Frage' : 'Fragen' }})</option>
                    {% endfor %}
                </select>
            </div>

            <div id="questions-container" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 12px; font-weight: 600;">Fragen festlegen</label>
                {% for frage in ['Wie war die heutige Stunde?', 'Wie ist aktuell das Klassenklima?'] %}
                    <div class="question-row" style="background: #ffffff; border: 1px solid #e2e8f0; border-left: 4px solid var(--primary-color); border-radius: 8px; padding: 16px; margin-bottom: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                            <input type="text" name="questions[{{ loop.index0 }}][text]" value="{{ frage }}" placeholder="Fragentext eingeben…" aria-label="Fragentext" required style="flex: 1; min-width: 200px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; box-sizing: border-box;">
                            <select name="questions[{{ loop.index0 }}][type]" class="frage-typ" style="width: 210px; min-width: 170px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: white; font-size: 0.9rem; color: #334155; cursor: pointer;">
                                <option value="emoji" selected>Emoji-Bewertung (1–5)</option>
                                <option value="text">Freitext-Antwort</option>
                                <option value="mc">Multiple Choice</option>
                            </select>
                            <button type="button" class="frage-loeschen" aria-label="Frage löschen" style="background: #ff7675; color: white; border: none; padding: 10px 14px; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: bold; height: 42px;">&times;</button>
                        </div>
                        <div class="options-container" style="display: none; margin-top: 12px; padding-top: 12px; border-top: 1px dashed #e2e8f0;">
                            <label style="display: block; font-size: 0.85em; color: #475569; margin-bottom: 6px; font-weight: 600;">Antwortoptionen (kommagetrennt):</label>
                            <input type="text" name="questions[{{ loop.index0 }}][options]" value="" placeholder="z.B. Ja, Nein, Vielleicht" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                        </div>
                    </div>
                {% endfor %}
            </div>

            <button type="button" id="frage-hinzufuegen" style="background: #eee; border: 1px dashed #ccc; width: 100%; padding: 10px; border-radius: 6px; cursor: pointer; margin-bottom: 25px; color: #666;">+ Weitere Frage hinzufügen</button>

            <div style="margin-bottom: 25px; padding: 15px; background: #fff; border: 1px solid #eee; border-radius: 6px;">
                <label for="save-as-template-checkbox" style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600;">
                    <input type="checkbox" id="save-as-template-checkbox" name="save_template" value="1">
                    <span>Aktuelle Fragen als Vorlage speichern</span>
                </label>
                <div id="template-title-container" style="display: none; margin-top: 15px;">
                    <label for="template-title-input" style="display: block; margin-bottom: 8px; font-size: 0.9em; color: var(--text-muted);">Name der Vorlage</label>
                    <input type="text" name="template_title" id="template-title-input" placeholder="z.B. Feedback zum Projektunterricht" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                </div>
            </div>

            <div style="text-align: right;">
                <button type="submit" class="btn btn-primary" style="background-color: var(--primary-color); color: white; border: none; padding: 12px 30px; border-radius: 6px; cursor: pointer; font-weight: 600;">Sitzung erstellen &amp; QR-Code generieren</button>
            </div>
        </form>
    {% endif %}
</div>

{# --- Vergangene Sitzungen ------------------------------------------- #}
<div class="content-box" style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 15px; flex-wrap: wrap; margin-bottom: 5px;">
        <h3 style="margin: 0;">Vergangene Sitzungen</h3>
        {% if history is not empty %}
            <a href="/feedback.php?tab=trends" style="font-size: 0.88em; color: var(--primary-color); text-decoration: none;">Entwicklung ansehen →</a>
        {% endif %}
    </div>

    {% if history is empty %}
        <p style="text-align: center; color: var(--text-muted); padding: 35px 0; margin: 0;">
            Noch keine Sitzungen durchgeführt. Starten Sie oben Ihre erste Feedback-Runde.
        </p>
    {% else %}
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                <thead>
                    <tr style="text-align: left; border-bottom: 2px solid var(--border-color);">
                        <th style="padding: 10px;">Datum</th>
                        <th style="padding: 10px;">Klasse / Fach</th>
                        <th style="padding: 10px;">Fragen &amp; Durchschnittswerte</th>
                        <th style="padding: 10px; text-align: right;">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in history|reverse %}
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 10px; white-space: nowrap;">{{ s.created_at|date('d.m.y') }}</td>
                            <td style="padding: 10px;"><strong>{{ s.klasse }}</strong> &middot; {{ s.fach }}</td>
                            <td style="padding: 10px;">
                                {% for q in s.questions %}
                                    <div style="font-size: 0.85em; margin-bottom: 4px;">
                                        <span style="font-weight: 600; color: var(--primary-color);">{{ q.avg is null ? '–' : q.avg|number_format(1) }}</span>
                                        <span style="color: var(--text-muted);">{{ q.text }}</span>
                                    </div>
                                {% endfor %}
                            </td>
                            <td style="padding: 10px; text-align: right; white-space: nowrap;">
                                <a href="/feedback_view.php?id={{ s.id }}" style="text-decoration: none; font-size: 0.9em; color: var(--primary-color);">Details →</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# --- Vorlagen: unauffällig ganz unten ------------------------------- #}
{% if templates is not empty %}
    <details class="content-box" style="margin-top: 30px;">
        <summary style="font-weight: 600; cursor: pointer; outline: none; color: var(--text-muted);">
            🗂️ Meine Vorlagen verwalten ({{ templates|length }})
        </summary>
        <p style="color: var(--text-muted); font-size: 0.9em; margin: 15px 0;">
            Vorlagen lassen sich oben beim Erstellen einer Sitzung laden. Hier können Sie sie löschen.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px;">
            {% for t in templates %}
                <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; gap: 10px;">
                    <div style="min-width: 0;">
                        <strong style="display: block; color: var(--text-dark); overflow: hidden; text-overflow: ellipsis;">{{ t.title }}</strong>
                        <span style="font-size: 0.85em; color: var(--text-muted);">{{ t.question_count }} {{ t.question_count == 1 ? 'Frage' : 'Fragen' }}</span>
                    </div>
                    <form action="/feedback_action.php" method="POST" class="vorlage-loeschen" style="margin: 0; flex-shrink: 0;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="action" value="delete_template">
                        <input type="hidden" name="template_id" value="{{ t.id }}">
                        <button type="submit" class="btn-danger" style="background-color: var(--danger-color); color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 0.85em;">Löschen</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </details>
{% endif %}

{% if active_session %}
    <div id="qrModal" class="qr-modal">
        <button class="close-modal" aria-label="Schließen">&times;</button>
        <div class="qr-modal-content">
            <h2 style="margin-top: 0; color: var(--primary-color);">{{ active_session.klasse }} &middot; {{ active_session.fach }}</h2>
            <img src="{{ qr_data_uri(host_url ~ '/student_feedback.php?t=' ~ active_session.token, 500) }}" class="qr-large" alt="QR-Code in Großansicht">
            <p style="margin-top: 20px; font-weight: 600; font-size: 1.2em;">Scan mich für Feedback!</p>
            <code style="display: block; background: #f0f0f0; padding: 10px; border-radius: 4px; font-size: 0.9em; margin-top: 10px; word-break: break-all;">{{ host_url }}/student_feedback.php?t={{ active_session.token }}</code>
        </div>
    </div>
{% endif %}
