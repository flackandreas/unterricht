<!DOCTYPE html>
<html lang="de">
<head>
    {% include 'partials/_student_head.twig' %}
    <title>{{ assignment.title }} - Hausaufgabe einreichen</title>
</head>
<body>

<div class="container">
    <h1>{{ assignment.title }}</h1>
    <div class="meta">
        {{ assignment.klasse }} &middot; {{ assignment.fach }}
        {% if due_date %}
            &middot;
            <span style="color: {{ is_overdue ? 'var(--danger-color)' : '#64748b' }}; font-weight: {{ is_overdue ? '600' : '400' }};">
                Abgabe bis {{ due_date|date('d.m.Y, H:i') }} Uhr{{ is_overdue ? ' (überfällig)' : '' }}
            </span>
        {% endif %}
    </div>

    {% include 'partials/_class_quest.twig' with {
        'klasse': assignment.klasse,
        'fach': assignment.fach
    } %}

    {% if error %}
        <div class="alert alert-error">{{ error }}</div>
    {% endif %}

    {% if is_overdue %}
        <div class="alert alert-info">
            Die Abgabefrist ist abgelaufen. Du kannst weiterhin einreichen – deine Lehrkraft sieht,
            dass die Abgabe verspätet war.
        </div>
    {% endif %}

    <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-bottom: 25px;">
        <strong style="display: block; margin-bottom: 6px; font-size: 0.95em;">Aufgabe</strong>
        <p class="math-format" style="margin: 0; font-size: 0.92em; line-height: 1.5; color: #475569; white-space: pre-wrap;">{{ assignment.description }}</p>
    </div>

    {% if criteria is not empty %}
        <div style="margin-bottom: 25px;">
            <strong style="display: block; margin-bottom: 8px; font-size: 0.95em;">📋 Bewertet wird nach diesen Kriterien</strong>
            <ul style="margin: 0; padding-left: 20px; font-size: 0.88em; color: #475569; line-height: 1.6;">
                {% for k in criteria %}
                    <li>{{ k.label }} <span style="color: #94a3b8;">({{ k.max_points }} Punkte)</span></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <p style="margin-bottom: 25px;">
        Trage deinen Namen ein und lade ein Foto deiner Hausaufgabe hoch.
        Du bekommst sofort eine Bestätigung; die Auswertung erscheint kurz darauf automatisch.
    </p>

    <form action="" method="POST" enctype="multipart/form-data" id="uploadForm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="form-group">
            <label for="student_name">Dein Vor- und Nachname</label>
            <input type="text" id="student_name" name="student_name" required placeholder="z.B. Max Mustermann" autocomplete="name">
        </div>

        <div class="form-group" style="margin-bottom: 30px;">
            <label for="homework_image">Foto der Hausaufgabe (JPG, PNG oder WEBP)</label>
            <input type="file" id="homework_image" name="homework_image" accept="image/jpeg, image/png, image/webp" capture="environment" required>
        </div>

        <button type="submit" id="submitBtn">Hochladen &amp; auswerten lassen</button>

        <div class="loading" id="loadingSection" style="display: none;">
            <div class="spinner"></div>
            <div style="color: #64748b; font-weight: 500;">Deine Abgabe wird hochgeladen …</div>
        </div>
    </form>
</div>

{% include 'partials/_math_format.twig' %}
<script>
    document.getElementById('uploadForm').addEventListener('submit', function () {
        document.getElementById('submitBtn').style.display = 'none';
        document.getElementById('loadingSection').style.display = 'block';
    });
</script>

</body>
</html>
