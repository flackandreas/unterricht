{% import "_symbole.twig" as symbol %}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Übersicht{% endblock %} · Unterricht & Feedback</title>
    <link rel="stylesheet" href="{{ asset('/css/app_styles.css') }}">
    <!-- Quick external font fallback to match the app style vibes -->
    <link href="{{ asset('/css/fonts.css') }}" rel="stylesheet">
    <!-- SweetAlert2 CDN -->
    <script src="{{ asset('/vendor/sweetalert2/sweetalert2.all.min.js') }}"></script>
    <script src="{{ asset('/js/app.js') }}" defer></script>
    <style>
        /* Fallback quick fixes if app_styles.css isn't perfectly carrying over all resets */
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; }
        
        /* Collapsible Navigation Dropdowns styling */
        .nav-details {
            margin: 3px 0;
            outline: none;
        }
        .nav-summary {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            color: #f0ebe6;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            list-style: none; /* Hide default arrow */
            transition: background-color 0.2s;
            outline: none;
        }
        .nav-summary::-webkit-details-marker {
            display: none; /* Hide default Safari arrow */
        }
        .nav-summary:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        .nav-details[open] .nav-summary {
            background-color: rgba(255, 255, 255, 0.05);
            font-weight: 500;
        }
        .nav-summary-arrow {
            margin-left: auto;
            font-size: 0.8em;
            transition: transform 0.2s ease;
            color: var(--text-muted);
        }
        .nav-details[open] .nav-summary-arrow {
            transform: rotate(90deg);
        }
        .nav-submenu {
            list-style: none;
            padding: 2px 0 2px 25px;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .nav-submenu a {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            text-decoration: none;
            color: #d1c7bd;
            font-size: 0.9em;
            border-radius: 6px;
            transition: color 0.2s, background-color 0.2s;
        }
        .nav-submenu a:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.08);
        }
        .nav-submenu a.active {
            color: var(--primary-color);
            background-color: rgba(255, 255, 255, 0.1);
            font-weight: 600;
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon.svg') }}">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2c3e50">
    {% block extra_head %}{% endblock %}
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
</head>
<body>

{% if is_logged_in %}
<div class="app-layout" id="appLayout">
    <!-- Sidebar Navigation -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div>
                {# Bildmarke von schulos.de. Vorher stand hier das Favicon als
                   Buchstabe "S", gefolgt vom Text "choolHub" - der Markenname
                   war dadurch fuer Suche und Vorlesesoftware unauffindbar. #}
                <div class="sidebar-title">
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true" style="flex-shrink: 0;">
                        <path d="M16 4L4 10L16 16L28 10L16 4Z" fill="currentColor"/>
                        <path d="M4 14.5V21.5L16 27.5L28 21.5V14.5L16 20.5L4 14.5Z" fill="currentColor" opacity="0.55"/>
                    </svg>
                    <span class="marke__text">
                        <span class="marke__name">SchulOS</span>
                        <span class="marke__modul">Unterricht &amp; Feedback</span>
                    </span>
                </div>
            </div>
            <button id="nav-toggle" aria-label="Menü ein- oder ausklappen">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
                </svg>
            </button>
        </div>
        
        <ul class="nav-menu">
            <li class="nav-label">Start</li>
            <li class="nav-item">
                <a href="/dashboard" class="{{ is_current_page('dashboard_unterricht.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('home') }}</span>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ portal_adresse ? portal_adresse ~ '/' : '/index.php' }}">
                    <span class="nav-icon">{{ symbol.zeichne('wechsel') }}</span>
                    <span class="nav-text">{{ portal_adresse ? 'Zum Portal' : 'Portal-Auswahl' }}</span>
                </a>
            </li>
            
            {% if not is_admin %}
            <li class="nav-label">Unterricht</li>
            <li class="nav-item">
                <a href="/live.php" class="{{ is_current_page('live.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('blitz') }}</span>
                    <span class="nav-text">Unterricht live</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/live_report.php" class="{{ is_current_page('live_report.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('auge') }}</span>
                    <span class="nav-text">Beteiligung</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/vertretung.php" class="{{ is_current_page('vertretung.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('wechsel') }}</span>
                    <span class="nav-text">Vertretung</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin_homework.php" class="{{ is_current_page('admin_homework.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('buch') }}</span>
                    <span class="nav-text">Hausaufgaben (KI)</span>
                    {% set offen = pending_reviews() %}
                    {% if offen > 0 %}
                        <span class="nav-badge" title="Auswertungen warten auf Freigabe">{{ offen }}</span>
                    {% endif %}
                </a>
            </li>
            <li class="nav-item">
                {# Sitzungen, Auswertung und Verlauf sind ein Arbeitsablauf und
                   liegen deshalb unter einem Punkt. feedback_view.php ist die
                   Detailseite dazu und hält den Punkt ebenfalls aktiv. #}
                <a href="/feedback.php" class="{{ is_current_page('feedback.php') or is_current_page('feedback_view.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('trend') }}</span>
                    <span class="nav-text">Feedback &amp; Trends</span>
                </a>
            </li>
            {% endif %}
            
            {% if is_admin %}
            <div class="nav-separator"></div>
            
            <li class="nav-label">Verwaltung</li>
            <li class="nav-item">
                <a href="/admin_lehrer.php" class="{{ is_current_page('admin_lehrer.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('personen') }}</span>
                    <span class="nav-text">Lehrerverwaltung</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin_klassen.php" class="{{ is_current_page('admin_klassen.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('schule') }}</span>
                    <span class="nav-text">Klassenverwaltung</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin_schueler.php" class="{{ is_current_page('admin_schueler.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('personen') }}</span>
                    <span class="nav-text">Klassenlisten</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin_system.php" class="{{ is_current_page('admin_system.php') ? 'active' : '' }}">
                    <span class="nav-icon">{{ symbol.zeichne('einstellung') }}</span>
                    <span class="nav-text">Systemverwaltung</span>
                </a>
            </li>
            {% endif %}
            
            <div class="nav-separator"></div>
            
            <li class="nav-label">Benutzer</li>
            <li class="nav-item">
                <div style="padding: 10px 12px; color: var(--text-muted); font-size: 0.9em; display:flex; align-items:center;">
                    <span class="nav-icon">{{ symbol.zeichne('person') }}</span>
                    <span class="nav-text">{{ current_user_name }}</span>
                </div>
            </li>
            <li class="nav-item">
                <a href="#" id="dark-mode-toggle" onclick="event.preventDefault();">
                    <span class="nav-icon">{{ symbol.zeichne('mond') }}</span>
                    <span class="nav-text">Design wechseln</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/logout.php">
                    <span class="nav-icon">{{ symbol.zeichne('abmelden') }}</span>
                    <span class="nav-text">Abmelden</span>
                </a>
            </li>
        </ul>
    </nav>
    
    <!-- Main Content Area -->
    <main class="main-content">
        {% block content %}{% endblock %}
    </main>
</div> <!-- End app-layout -->

{% else %}
    <!-- Full page for login and other public routes -->
    <main class="login-layout" style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background-color: var(--bg-main);">
        {% block content_public %}{% endblock %}
    </main>
{% endif %}

<!-- SweetAlert2 Flash Messages handler -->
{% if flash_success or flash_error %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        {% if flash_success %}
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });
        Toast.fire({
            icon: 'success',
            title: '{{ flash_success|escape('js') }}'
        });
        {% endif %}
        
        {% if flash_error %}
        Swal.fire({
            icon: 'error',
            title: 'Fehler!',
            text: '{{ flash_error|escape('js') }}',
            confirmButtonColor: 'var(--danger-color)'
        });
        {% endif %}
    });
</script>
{% endif %}

{% block extra_scripts %}{% endblock %}

</body>
</html>
