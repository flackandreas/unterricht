{
    "require": {
        "twig/twig": "^3.23",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.10",
        "endroid/qr-code": "^5.0",
        "schulos/sso": "@dev"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "migrate": "php bin/migrate.php",
        "work": "php bin/worker.php"
    },
    "repositories": [
        {
            "comment": "Gemeinsamer OpenID-Connect-Client der SchulOS-Module. Solange das Paket noch nicht auf GitHub liegt, wird es aus dem Nachbarverzeichnis kopiert (symlink: false) - so landet es in vendor/ und wird wie die uebrigen Abhaengigkeiten mit ausgeliefert.",
            "type": "path",
            "url": "../../schulos-sso",
            "options": {
                "symlink": false
            }
        }
    ]
}
