{
    "require": {
        "twig/twig": "^3.23",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.10",
        "endroid/qr-code": "^5.0",
        "schulos/sso": "^1.0"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "migrate": "php bin/migrate.php",
        "work": "php bin/worker.php"
    },
    "repositories": [
        {
            "comment": "Gemeinsamer OpenID-Connect-Client der SchulOS-Module. HTTPS statt SSH, damit die CI ohne hinterlegten Schluessel an das oeffentliche Paket kommt.",
            "type": "vcs",
            "url": "https://github.com/flackandreas/schulos-sso.git"
        }
    ]
}
