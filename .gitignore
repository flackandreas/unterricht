# Development Database
db-data/

# Environment and Secrets (if any added later)
.env
.env.*
# Die Vorlage gehoert ins Repository - ohne sie muss jede neue
# Installation die benoetigten Variablen erraten.
!.env.example
*.secret
Oauth/*.json


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# Temporary Files
/tmp
/tmp/
*.tmp
*.bak

# Hochgeladene Dateien (Hausaufgabenfotos, Musterloesungen)
# Enthalten personenbezogene Daten und gehoeren nicht in die Versionsverwaltung.
src/storage/
src/public/uploads/*
!src/public/uploads/.htaccess

# Composer-Abhaengigkeiten (composer.lock ist versioniert)
# src/vendor/ bleibt bewusst versioniert: das Deployment bindet src/ direkt
# ein und fuehrt kein composer install aus.

# Twig-Cache und Migrationsvermerk werden zur Laufzeit erzeugt
src/storage/cache/
src/storage/migration-state

# Werkzeug-Caches
src/.phpunit.result.cache
.phpunit.cache/
